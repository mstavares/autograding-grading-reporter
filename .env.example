# Google Sheets API Configuration
# Copy this file to .env and fill with your actual values

# Base64-encoded service account JSON credentials
SHEETS_CREDENTIALS=

# Your Google Spreadsheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=

# Name of the worksheet/tab to use
WORKSHEET_NAME=

# Maximum number of authors allowed
AUTHORS_AMOUNT=2

# GitHub repository (format: owner/repo)
GITHUB_REPOSITORY=test-user/test-repo
